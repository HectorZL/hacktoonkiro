# Supabase público para el navegador
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Gemini se usa exclusivamente desde el servidor. Nunca uses NEXT_PUBLIC_ para esta clave.
GEMINI_API_KEY=tu_clave_de_gemini
# Modelo económico opcional; el valor predeterminado es gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite
